# Copia este archivo a .env.local (ignorado por git). Todas son variables de servidor; ninguna llega al navegador.

# Integración interna de Notion, de solo lectura, compartida únicamente con la base «Web Sophisnavi».
# Sin ella, `pnpm build` conserva data/content/content.json y no consulta Notion.
NOTION_TOKEN=

# verification_token que Notion envía al crear la suscripción de webhook (se imprime en los logs de Vercel).
# Firma HMAC-SHA256 de cada evento; sin él, /api/notion/webhook responde 503.
NOTION_WEBHOOK_SECRET=

# Deploy Hook de Vercel (Settings → Git → Deploy Hooks, rama main). El webhook lo llama para lanzar un build.
VERCEL_DEPLOY_HOOK_URL=

# Opcional: otro data source de Notion (por defecto, el de «Web Sophisnavi»).
# NOTION_DATA_SOURCE_ID=
